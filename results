(function(){
"use strict";
const DEFAULT_RESULTS={overall:78,band:{label:"STRONG FOUNDATION",description:"You have meaningful AI capability already. Your next level comes from becoming more deliberate about direction, evaluation, iteration and reusable systems."},dimensions:[{id:"direction",name:"Direction",short:"Director",score:82,color:"#ed42c4",description:"You can give AI a destination. Make the desired outcome, audience, constraints and success criteria even clearer."},{id:"communication",name:"Communication",short:"Communicator",score:88,color:"#6575ff",description:"You can translate intent into language AI can use. Stronger context and clearer constraints can make good requests even more powerful."},{id:"evaluation",name:"Evaluation",short:"Evaluator",score:74,color:"#35e39b",description:"You have a useful instinct for judging quality. Turning that instinct into explicit scorecards will make decisions more consistent."},{id:"iteration",name:"Iteration",short:"Improver",score:69,color:"#ffd45a",description:"You understand that strong work gets refined. Learn to diagnose what is weak while protecting what already works."},{id:"systems",name:"Systems",short:"Systems Builder",score:59,color:"#765cff",description:"You are beginning to think beyond one-off answers. Reusable workflows, templates and role instructions can create significant leverage."}],areas:[{id:"writing",name:"Writing & Communication",score:84},{id:"research",name:"Research & Information",score:79},{id:"brainstorming",name:"Brainstorming & Ideas",score:87},{id:"content",name:"Content Creation",score:91},{id:"business",name:"Business & Strategy",score:76},{id:"marketing",name:"Marketing & Sales",score:72},{id:"learning",name:"Learning & Education",score:81},{id:"coding",name:"Coding & Software",score:54},{id:"images",name:"Images & Visual Creation",score:73},{id:"video",name:"Video & Media",score:68},{id:"audio",name:"Audio & Voice",score:66},{id:"data",name:"Data & Analytics",score:61},{id:"automation",name:"Automation & Workflows",score:57},{id:"agents",name:"AI Agents",score:52},{id:"productivity",name:"Productivity & Personal Work",score:80},{id:"presentations",name:"Presentations & Documents",score:77},{id:"reasoning",name:"Problem Solving & Reasoning",score:75},{id:"custom",name:"Custom AI Systems",score:63}]};
const $=s=>document.querySelector(s);const clamp=(v,a,b)=>Math.max(a,Math.min(b,Number.isFinite(Number(v))?Number(v):a));const esc=v=>String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;");
function external(){if(window.MAXESS_RESULTS&&typeof window.MAXESS_RESULTS==="object")return window.MAXESS_RESULTS;try{const x=localStorage.getItem("maxessResults");return x?JSON.parse(x):null}catch(e){return null}}
function merge(s){const r=JSON.parse(JSON.stringify(DEFAULT_RESULTS));if(!s)return r;if(Number.isFinite(Number(s.overall)))r.overall=clamp(s.overall,0,100);if(s.band)r.band={...r.band,...s.band};if(Array.isArray(s.dimensions))r.dimensions=s.dimensions.map((x,i)=>({...r.dimensions[i%5],...x,score:clamp(x.score,0,100)}));if(Array.isArray(s.areas))r.areas=s.areas.map((x,i)=>({...r.areas[i%18],...x,score:clamp(x.score,0,100)}));return r}
