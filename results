function renderBandTable(){const a=$("#scoreHeading")?.parentElement;if(!a||document.querySelector(".score-band-table"))return;const c=document.createElement("div");c.className="score-band-table";const s=results.overall;[{min:90,max:100,n:"Exceptional",d:"High capability and strong leverage."},{min:80,max:89,n:"Advanced",d:"Strong capability with room to systematize."},{min:70,max:79,n:"Strong Foundation",d:"Useful capability with clear leverage ahead."},{min:60,max:69,n:"Developing",d:"Useful foundation with important gaps."},{min:0,max:59,n:"Starting Point",d:"A clear map for building fundamentals."}].forEach(b=>{const e=document.createElement("div");e.className="score-band"+(s>=b.min&&s<=b.max?" active":"");e.innerHTML=`<strong>${b.n}</strong><span>${b.min}–${b.max} · ${b.d}</span>`;c.appendChild(e)});a.appendChild(c)}
function toast(x){const t=$("#toast");t.textContent=x;t.classList.add("show");clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove("show"),2400)}
function animateScore(){const e=$("#overallScore"),target=Math.round(results.overall);if(matchMedia("(prefers-reduced-motion: reduce)").matches){e.textContent=target;return}const st=performance.now();function f(n){const p=Math.min(1,(n-st)/900);e.textContent=Math.round(target*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(f)}requestAnimationFrame(f)}
