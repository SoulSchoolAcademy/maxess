function renderDimensions(){const c=$("#dimensionList");c.innerHTML="";results.dimensions.forEach(d=>{const e=document.createElement("article");e.className="dimension";e.tabIndex=0;e.setAttribute("role","button");e.innerHTML=`<div class="dimension-top"><div class="dimension-name"><span class="dimension-dot" style="background:${esc(d.color)};color:${esc(d.color)}"></span>${esc(d.name)}</div><div class="dimension-score">${Math.round(d.score)}%</div></div><div class="gauge"><div class="gauge-fill" style="--dimension-color:${esc(d.color)}" data-width="${d.score}%"></div></div><p>${esc(d.description||insight(d))}</p>`;const go=()=>openDetail(d.name,d.score,d.description||insight(d),"This capability contributes directly to the quality and leverage of your AI work.",opp(d),`${d.short||d.name} CAPABILITY`);e.onclick=go;e.onkeydown=x=>{if(x.key==="Enter"||x.key===" "){x.preventDefault();go()}};c.appendChild(e)});requestAnimationFrame(()=>document.querySelectorAll(".gauge-fill").forEach(x=>x.style.width=x.dataset.width))}
