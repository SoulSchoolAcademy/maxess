function renderInsights(){const s=sorted(),a=s[0],o=s.at(-1);$("#insightOne").textContent=`${a.name} is currently your strongest core capability at ${Math.round(a.score)}/100. ${insight(a)}`;$("#insightTwo").textContent=`${o.name} is your biggest leverage opportunity at ${Math.round(o.score)}/100. ${opp(o)}`;$("#insightThree").textContent=`Strengthen ${o.name} while using ${a.name} as an existing advantage. The goal is not to improve everything at once; it is to improve what creates the most leverage.`}
function point(cx,cy,r,i,n,s){const a=-Math.PI/2+i*Math.PI*2/n;return{x:cx+Math.cos(a)*r*s,y:cy+Math.sin(a)*r*s}}function pts(a){return a.map(p=>`${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ")}
function renderRadar(){const svg=$("#radar"),ds=results.dimensions.slice(0,5),cx=350,cy=270,r=185,n=ds.length;let m="";[.25,.5,.75,1].forEach(s=>m+=`<polygon class="radar-grid" points="${pts(ds.map((_,i)=>point(cx,cy,r,i,n,s)))}"></polygon>`);ds.forEach((_,i)=>{const p=point(cx,cy,r,i,n,1);m+=`<line class="radar-axis" x1="${cx}" y1="${cy}" x2="${p.x}" y2="${p.y}"></line>`});const ns=ds.map((d,i)=>point(cx,cy,r,i,n,Math.max(.05,d.score/100)));m+=`<polygon class="radar-shape" points="${pts(ns)}"></polygon>`;ns.forEach(p=>m+=`<circle class="radar-node" cx="${p.x}" cy="${p.y}" r="7"></circle>`);ds.forEach((d,i)=>{const p=point(cx,cy,r+44,i,n,1);m+=`<text class="radar-label" x="${p.x}" y="${p.y}" text-anchor="middle" dominant-baseline="middle">${esc(d.name)}</text>`});svg.innerHTML=m}
function openDetail(title,score,body,why,next,kicker){$("#detailModalKicker").textContent=kicker;$("#detailModalTitle").textContent=title;$("#detailModalScore").textContent=`${Math.round(score)}%`;$("#detailModalBody").textContent=body;$("#detailWhy").textContent=why;$("#detailNext").textContent=next;$("#detailModalGauge").style.width=`${clamp(score,0,100)}%`;$("#detailModal").classList.add("open");$("#detailModal").setAttribute("aria-hidden","false");document.body.classList.add("modal-open");$("#detailClose").focus()}
