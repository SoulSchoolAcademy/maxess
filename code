<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#020204">
<meta name="color-scheme" content="dark">
<title>MAXESS — AI Mastery Assessment</title>
<meta name="maxess-build" content="AAA-2026-08-15-results-fresh-flagship">
<meta name="maxess-aaa-pass" content="2026-08-15-results-fresh-flagship">
<style>
:root{
  --bg:#020204;
  --bg2:#050507;
  --surface:#09090d;
  --surface2:#101016;
  --surface3:#16131d;

  --white:#fff;
  --text:#f8f7fb;
  --muted:#aaa7b3;
  --muted2:#77747f;

  --purple:#8a5cff;
  --purple2:#b895ff;
  --purple3:#5424b5;

  --gold:#ffd45a;
  --green:#35e39b;
  --blue:#3ca8ff;
  --violet:#765cff;
  --magenta:#ed42c4;
  --sapphire:#4e8cff;

  --line:rgba(255,255,255,.11);
  --line2:rgba(255,255,255,.18);

  --ease:cubic-bezier(.2,.8,.2,1);
}

*{
  box-sizing:border-box;
}

html{
  min-height:100%;
  background:var(--bg);
  scroll-behavior:smooth;
}

body{
  margin:0;
  min-height:100%;
  background:var(--bg);
  color:var(--text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  overflow-x:hidden;
}

button{
  font:inherit;
  -webkit-tap-highlight-color:transparent;
}

button,.answer,.interest-area{
  touch-action:manipulation;
  user-select:none;
  -webkit-user-select:none;
}

button:focus-visible{
  outline:2px solid #fff;
  outline-offset:4px;
}

button:disabled{
  cursor:not-allowed;
}

::selection{
  background:rgba(138,92,255,.35);
  color:#fff;
}


/* =========================================================
   GLOBAL APP
========================================================= */

.maxess-app{
  position:relative;
  min-height:100svh;
  min-height:100dvh;
  overflow:hidden;
  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(111,67,255,.20),
      transparent 35%
    ),
    radial-gradient(
      circle at 100% 48%,
      rgba(85,39,190,.08),
      transparent 35%
    ),
    radial-gradient(
      circle at 0% 78%,
      rgba(117,48,190,.06),
      transparent 32%
    ),
    #020204;
}

.maxess-app::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.025),
      transparent 18%
    );
  z-index:0;
}

.maxess-app::after{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  opacity:.12;
  background-image:
    radial-gradient(
      rgba(255,255,255,.35) .5px,
      transparent .5px
    );
  background-size:5px 5px;
  mask-image:
    linear-gradient(
      to bottom,
      transparent,
      black 18%,
      black 82%,
      transparent
    );
  z-index:0;
}

.app-inner{
  position:relative;
  z-index:1;
  width:100%;
  min-height:100svh;
  min-height:100dvh;
  display:flex;
  flex-direction:column;
  padding:
    max(12px,env(safe-area-inset-top))
    max(12px,env(safe-area-inset-right))
    max(18px,env(safe-area-inset-bottom))
    max(12px,env(safe-area-inset-left));
}


/* =========================================================
   TOP BAR
========================================================= */

.topbar{
  width:100%;
  max-width:1180px;
  margin:0 auto;
  display:grid;
  grid-template-columns:auto 1fr auto;
  align-items:center;
  gap:18px;
  padding:4px 2px 14px;
}

.brand{
  display:flex;
  align-items:center;
  white-space:nowrap;
  font-size:clamp(18px,2vw,25px);
  line-height:1;
  font-weight:950;
  letter-spacing:.15em;
  text-shadow:0 0 20px rgba(138,92,255,.16);
}

.brand-max{
  color:#fff;
}

.brand-ess{
  color:#b58cff;
}















































































































.question-count-chip{
  justify-self:end;
  min-width:128px;
  padding:9px 12px;
  border:1px solid rgba(181,140,255,.24);
  border-radius:999px;
  background:rgba(138,92,255,.055);
  color:#bdb4ce;
  font-size:9px;
  font-weight:950;
  letter-spacing:.10em;
  text-align:center;
  white-space:nowrap;
}


/* =========================================================
   PROGRESS
========================================================= */

.progress-hud{
  justify-self:center;
  width:min(430px,100%);
  display:flex;
  align-items:center;
  gap:12px;
  padding:8px 12px;
  border:1px solid rgba(255,255,255,.14);
  border-radius:999px;
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.075),
      rgba(255,255,255,.025)
    );
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.09),
    0 12px 35px rgba(0,0,0,.35),
    0 0 35px rgba(116,62,255,.08);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}

.progress-location{
  display:flex;
  align-items:center;
  gap:7px;
  min-width:max-content;
}

.progress-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:#a477ff;
  box-shadow:
    0 0 9px rgba(164,119,255,.8),
    0 0 18px rgba(164,119,255,.35);
}

.progress-label{
  font-size:9px;
  font-weight:950;
  letter-spacing:.13em;
  color:#d7d3df;
  white-space:nowrap;
}

.progress-track{
  position:relative;
  flex:1;
  height:6px;
  min-width:90px;
  overflow:hidden;
  border-radius:999px;
  background:rgba(255,255,255,.075);
  box-shadow:inset 0 1px 2px rgba(0,0,0,.75);
}

.progress-fill{
  position:absolute;
  inset:0 auto 0 0;
  width:0%;
  border-radius:inherit;
  background:
    linear-gradient(
      90deg,
      #6634d8,
      #8d5aff 55%,
      #c09bff
    );
  box-shadow:
    0 0 12px rgba(138,92,255,.7),
    0 0 28px rgba(138,92,255,.3);
  transition:width .55s var(--ease);
}

.progress-percent{
  min-width:35px;
  text-align:right;
  font-size:9px;
  font-weight:900;
  color:#a9a5b3;
}


/* =========================================================
   MAIN BOARD
========================================================= */

.board-wrap{
  flex:1;
  width:100%;
  max-width:1180px;
  margin:0 auto;
  display:flex;
}

.board{
  position:relative;
  width:100%;
  min-height:0;
  display:flex;
  flex-direction:column;
  border:1px solid rgba(145,101,255,.48);
  border-radius:30px;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(128,75,255,.075),
      transparent 38%
    ),
    linear-gradient(
      180deg,
      #07070a 0%,
      #040406 100%
    );
  box-shadow:
    0 0 0 1px rgba(255,255,255,.025),
    0 35px 90px rgba(0,0,0,.72),
    0 0 75px rgba(80,38,190,.09),
    inset 0 1px 0 rgba(255,255,255,.10);
  overflow:hidden;
}

.board::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(
      120deg,
      rgba(255,255,255,.035),
      transparent 20%,
      transparent 76%,
      rgba(117,67,255,.035)
    );
}

.board::after{
  content:"";
  position:absolute;
  left:12%;
  right:12%;
  top:0;
  height:1px;
  pointer-events:none;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(194,161,255,.65),
      transparent
    );
  box-shadow:0 0 20px rgba(148,93,255,.35);
}

.board-content{
  position:relative;
  z-index:1;
  width:100%;
  min-height:100%;
  display:flex;
  flex-direction:column;
  padding:clamp(20px,3vw,34px);
}


/* =========================================================
   COMMAND ROW
========================================================= */

.command-row{
  position:relative;
  z-index:4;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  flex:0 0 auto;
  margin-bottom:clamp(18px,2.4vw,30px);
}


/* =========================================================
   NAYA BUTTON
========================================================= */

.naya-button{
  min-height:54px;
  display:flex;
  align-items:center;
  gap:10px;
  padding:6px 15px 6px 7px;
  border:1px solid rgba(255,255,255,.20);
  border-radius:19px;
  color:#fff;
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.065),
      rgba(255,255,255,.018)
    );
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.10),
    0 10px 28px rgba(0,0,0,.42),
    0 0 25px rgba(118,92,255,.06);
  cursor:pointer;
  transition:
    transform .22s var(--ease),
    border-color .22s ease,
    box-shadow .22s ease;
}

.naya-button:hover{
  transform:translateY(-2px);
  border-color:rgba(255,255,255,.45);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.13),
    0 14px 34px rgba(0,0,0,.5),
    0 0 32px rgba(118,92,255,.16);
}

.naya-button.playing{
  border-color:rgba(181,140,255,.75);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.14),
    0 12px 32px rgba(0,0,0,.48),
    0 0 35px rgba(138,92,255,.25);
}

.naya-orb{
  position:relative;
  width:39px;
  height:39px;
  flex:0 0 39px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:
    radial-gradient(
      circle at 30% 20%,
      #fff 0%,
      #dfd1ff 12%,
      #946dff 38%,
      #3b1b83 70%,
      #09050f 100%
    );
  border:1px solid #ddd1ff;
  box-shadow:
    inset 0 2px 4px rgba(255,255,255,.75),
    0 0 22px rgba(116,76,255,.38),
    0 7px 15px rgba(0,0,0,.6);
}

.naya-orb::after{
  content:"";
  width:0;
  height:0;
  margin-left:3px;
  border-top:7px solid transparent;
  border-bottom:7px solid transparent;
  border-left:11px solid #fff;
  filter:drop-shadow(0 2px 3px rgba(0,0,0,.6));
}

.naya-button.playing .naya-orb::after{
  width:10px;
  height:13px;
  margin-left:0;
  border:0;
  background:
    linear-gradient(
      90deg,
      #fff 0 35%,
      transparent 35% 65%,
      #fff 65% 100%
    );
}

.naya-copy{
  display:flex;
  flex-direction:column;
  text-align:left;
  line-height:1.03;
}

.naya-copy strong{
  font-size:14px;
  font-weight:950;
}

.naya-copy span{
  margin-top:5px;
  font-size:10px;
  color:#c8c4d0;
  font-weight:700;
}


/* =========================================================
   BLACK CONTINUE BUTTON
========================================================= */

.continue-button,
.primary-black{
  position:relative;
  min-width:190px;
  min-height:54px;
  padding:0 22px;
  border-radius:18px;
  border:1px solid rgba(181,140,255,.78);
  color:#fff;
  background:
    linear-gradient(
      180deg,
      #15151a,
      #08080b
    );
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.09),
    0 12px 28px rgba(0,0,0,.62),
    0 0 28px rgba(116,55,223,.15);
  font-size:14px;
  font-weight:950;
  cursor:pointer;
  transition:
    transform .22s var(--ease),
    border-color .22s ease,
    box-shadow .22s ease,
    background .22s ease;
}

.continue-button::before,
.primary-black::before{
  content:"";
  position:absolute;
  left:10%;
  right:10%;
  top:5px;
  height:1px;
  background:rgba(255,255,255,.45);
}

.continue-button:hover:not(:disabled),
.primary-black:hover{
  transform:translateY(-2px);
  border-color:#c5a8ff;
  background:
    linear-gradient(
      180deg,
      #1b1721,
      #09090d
    );
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.13),
    0 15px 35px rgba(0,0,0,.66),
    0 0 42px rgba(155,96,255,.30);
}

.continue-button:disabled{
  color:rgba(255,255,255,.42);
  border-color:rgba(255,255,255,.10);
  background:#0b0b0e;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.04),
    0 7px 18px rgba(0,0,0,.30);
  opacity:.7;
}

.button-arrow{
  display:inline-block;
  margin-left:8px;
  font-size:17px;
  transition:transform .22s var(--ease);
}

.continue-button:hover:not(:disabled) .button-arrow{
  transform:translateX(3px);
}



/* =========================================================
   AAA STATUS RAIL
========================================================= */
.aaa-status-rail{width:min(860px,100%);margin:0 auto 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 12px;border:1px solid rgba(255,255,255,.075);border-radius:12px;background:rgba(255,255,255,.025);color:#918d9b;font-size:9px;font-weight:850;letter-spacing:.10em;text-transform:uppercase;}
.aaa-status-rail strong{color:#d7c9f6;font-weight:950;}
.aaa-status-rail .aaa-live{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;}
.aaa-status-rail .aaa-live::before{content:"";width:6px;height:6px;border-radius:50%;background:#35e39b;box-shadow:0 0 10px rgba(53,227,155,.7);}


/* =========================================================
   QUESTION
========================================================= */

.question-area{
  width:min(940px,100%);
  margin:0 auto;
  text-align:center;
  flex:0 0 auto;
}

.question-label{
  display:inline-flex;
  align-items:center;
  gap:8px;
  margin:0 0 12px;
  color:#c3a8ff;
  font-size:11px;
  font-weight:950;
  letter-spacing:.18em;
  text-transform:uppercase;
}

.question-label::before,
.question-label::after{
  content:"";
  width:24px;
  height:1px;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(163,125,255,.7)
    );
}

.question-label::after{
  transform:rotate(180deg);
}

.question-title{
  margin:0 auto;
  color:#fff;
  max-width:860px;
  font-size:clamp(25px,3.35vw,42px);
  line-height:1.08;
  letter-spacing:-.035em;
  font-weight:900;
  text-wrap:balance;
  text-shadow:0 2px 16px rgba(0,0,0,.45);
}

.question-rule{
  width:min(180px,35%);
  height:1px;
  margin:18px auto 0;
  background:
    linear-gradient(
      90deg,
      transparent,
      #8c5dff,
      transparent
    );
  box-shadow:0 0 15px rgba(124,82,255,.34);
}


/* =========================================================
   ANSWERS
========================================================= */

.answers{
  width:min(860px,100%);
  margin:clamp(16px,2vw,23px) auto 0;
  display:grid;
  gap:9px;
  flex:1 1 auto;
  align-content:start;
}

.answer{
  --accent:#fff;
  position:relative;
  width:100%;
  min-height:62px;
  display:grid;
  grid-template-columns:52px minmax(0,1fr) 30px;
  align-items:center;
  gap:13px;
  padding:7px;
  border:1px solid rgba(255,255,255,.105);
  border-radius:20px;
  color:#fff;
  text-align:left;
  background:
    linear-gradient(
      180deg,
      #111117,
      #08080c
    );
  box-shadow:
    0 8px 20px rgba(0,0,0,.34),
    inset 0 1px 0 rgba(255,255,255,.055);
  cursor:pointer;
  transition:
    transform .22s var(--ease),
    border-color .22s ease,
    box-shadow .22s ease,
    background .22s ease;
}

.answer:hover{
  transform:translateY(-2px);
  border-color:color-mix(
    in srgb,
    var(--accent) 58%,
    white 10%
  );
  box-shadow:
    0 13px 30px rgba(0,0,0,.46),
    0 0 28px color-mix(
      in srgb,
      var(--accent) 15%,
      transparent
    );
}

.answer.selected{
  transform:translateY(-1px);
  border-color:color-mix(
    in srgb,
    var(--accent) 82%,
    white 18%
  );
  background:
    linear-gradient(
      180deg,
      #181820,
      #0a0a0f
    );
  box-shadow:
    0 15px 35px rgba(0,0,0,.50),
    0 0 32px color-mix(
      in srgb,
      var(--accent) 22%,
      transparent
    ),
    inset 0 1px 0 rgba(255,255,255,.13);
}

.jewel{
  position:relative;
  width:50px;
  height:50px;
  display:grid;
  place-items:center;
  border-radius:17px;
  background:
    radial-gradient(
      circle at 28% 20%,
      #fff 0%,
      color-mix(
        in srgb,
        var(--accent) 72%,
        white 28%
      ) 10%,
      var(--accent) 42%,
      color-mix(
        in srgb,
        var(--accent) 35%,
        #000 65%
      ) 100%
    );
  border:1px solid rgba(255,255,255,.72);
  box-shadow:
    inset 0 2px 4px rgba(255,255,255,.7),
    inset 0 -7px 11px rgba(0,0,0,.45),
    0 5px 13px rgba(0,0,0,.55),
    0 0 20px color-mix(
      in srgb,
      var(--accent) 28%,
      transparent
    );
  overflow:hidden;
}

.jewel::after{
  content:"";
  position:absolute;
  left:13%;
  top:8%;
  width:48%;
  height:20%;
  border-radius:50%;
  background:linear-gradient(#fff9,transparent);
  filter:blur(2px);
}

.glyph{
  position:relative;
  z-index:1;
  font-size:22px;
  font-weight:950;
  text-shadow:0 2px 5px rgba(0,0,0,.55);
}

.answer-copy{
  min-width:0;
  padding:3px 0;
}

.answer-title{
  display:block;
  font-size:clamp(14px,1.55vw,17px);
  line-height:1.18;
  font-weight:900;
}

.answer-sub{
  display:block;
  margin-top:7px;
  color:#ddd9e4;
  font-size:clamp(13px,1.4vw,15px);
  line-height:1.28;
  font-weight:600;
}

.chevron{
  width:29px;
  height:29px;
  display:grid;
  place-items:center;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.11);
  color:#68656f;
  font-size:17px;
  transition:all .22s var(--ease);
}

.answer.selected .chevron,
.answer:hover .chevron{
  color:#fff;
  border-color:color-mix(
    in srgb,
    var(--accent) 55%,
    white 10%
  );
}


/* =========================================================
   FOOTER
========================================================= */

.footer{
  margin-top:12px;
  text-align:center;
  color:#595661;
  font-size:8px;
  font-weight:800;
  letter-spacing:.14em;
  text-transform:uppercase;
}


/* =========================================================
   TEACHING CLOUD / INTERSTITIAL
========================================================= */

.interstitial{
  position:fixed;
  inset:0;
  z-index:100;
  display:none;
  place-items:center;
  padding:24px;
  background:
    radial-gradient(
      circle at center,
      rgba(58,30,112,.20),
      rgba(0,0,0,.82) 58%,
      rgba(0,0,0,.94)
    );
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}

.interstitial.visible{
  display:grid;
  animation:veilIn .32s ease both;
}

@keyframes veilIn{
  from{opacity:0}
  to{opacity:1}
}

.teaching-cloud{
  position:relative;
  width:min(680px,100%);
  padding:42px 46px 38px;
  text-align:center;
  border-radius:
    44px
    54px
    48px
    56px /
    50px
    44px
    54px
    46px;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(181,140,255,.14),
      transparent 44%
    ),
    linear-gradient(
      145deg,
      rgba(25,20,35,.98),
      rgba(7,7,11,.98)
    );
  border:1px solid rgba(190,160,255,.40);
  box-shadow:
    0 35px 100px rgba(0,0,0,.72),
    0 0 70px rgba(119,71,255,.18),
    inset 0 1px 0 rgba(255,255,255,.10);
  animation:cloudIn .48s var(--ease) both;
}

@keyframes cloudIn{
  from{
    opacity:0;
    transform:translateY(20px) scale(.96);
  }
  to{
    opacity:1;
    transform:none;
  }
}

.cloud-glow{
  position:absolute;
  left:50%;
  top:-14px;
  width:130px;
  height:28px;
  transform:translateX(-50%);
  border-radius:50%;
  background:rgba(181,140,255,.35);
  filter:blur(20px);
  pointer-events:none;
}

.cloud-eyebrow{
  color:#cdb7ff;
  font-size:10px;
  font-weight:950;
  letter-spacing:.22em;
  text-transform:uppercase;
}

.cloud-icon{
  width:64px;
  height:64px;
  margin:18px auto 20px;
  display:grid;
  place-items:center;
  border-radius:50%;
  color:#fff;
  font-size:25px;
  background:
    radial-gradient(
      circle at 30% 20%,
      #fff,
      #c6a7ff 20%,
      #7747ed 48%,
      #25104f 100%
    );
  border:1px solid rgba(255,255,255,.75);
  box-shadow:
    inset 0 2px 4px rgba(255,255,255,.75),
    0 0 35px rgba(138,92,255,.30);
}

.cloud-title{
  margin:0;
  font-size:clamp(25px,4vw,39px);
  line-height:1.08;
  letter-spacing:-.035em;
  font-weight:950;
}

.cloud-body{
  max-width:550px;
  margin:18px auto 0;
  color:#ddd9e6;
  font-size:clamp(16px,2vw,19px);
  line-height:1.55;
  font-weight:600;
}

.cloud-body strong{
  color:#fff;
}

.cloud-actions{
  display:flex;
  justify-content:center;
  gap:12px;
  margin-top:28px;
}

.cloud-button{
  min-height:52px;
  padding:0 25px;
  border-radius:17px;
  border:1px solid rgba(181,140,255,.75);
  background:#08080b;
  color:#fff;
  font-weight:950;
  cursor:pointer;
  box-shadow:
    0 12px 28px rgba(0,0,0,.45),
    0 0 25px rgba(138,92,255,.12);
}

.cloud-button:hover{
  border-color:#d0baff;
  box-shadow:
    0 15px 35px rgba(0,0,0,.55),
    0 0 35px rgba(138,92,255,.24);
}

.cloud-button.secondary{
  border-color:rgba(255,255,255,.16);
  color:#c9c5d0;
}


/* =========================================================
   AI INTEREST EXPERIENCE
========================================================= */

.interests{
  display:none;
  width:min(1060px,100%);
  margin:auto;
  text-align:center;
}

.interests.visible{
  display:block;
  animation:resultIn .55s var(--ease) both;
}

.interest-eyebrow{
  color:#b895ff;
  font-size:10px;
  font-weight:950;
  letter-spacing:.22em;
  text-transform:uppercase;
}

.interest-title{
  margin:10px auto 0;
  max-width:800px;
  font-size:clamp(30px,5vw,52px);
  line-height:1.02;
  letter-spacing:-.045em;
  font-weight:950;
}

.interest-intro{
  max-width:700px;
  margin:16px auto 0;
  color:#c6c2cc;
  font-size:16px;
  line-height:1.55;
}

.interest-board{
  display:none;
  margin-top:30px;
}

.interest-board.active{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:13px;
  animation:boardIn .35s var(--ease) both;
}

@keyframes boardIn{
  from{
    opacity:0;
    transform:translateX(12px);
  }
  to{
    opacity:1;
    transform:none;
  }
}

.interest-area{
  --interest:#8a5cff;
  position:relative;
  min-height:108px;
  padding:19px 20px;
  text-align:left;
  border:1px solid rgba(255,255,255,.12);
  border-radius:28px;
  background:
    radial-gradient(
      circle at 20% 10%,
      color-mix(
        in srgb,
        var(--interest) 12%,
        transparent
      ),
      transparent 55%
    ),
    linear-gradient(
      145deg,
      #131219,
      #08080c
    );
  cursor:pointer;
  color:#fff;
  transition:
    transform .22s var(--ease),
    border-color .22s ease,
    box-shadow .22s ease;
}

.interest-area:hover{
  transform:translateY(-3px);
  border-color:color-mix(
    in srgb,
    var(--interest) 55%,
    white 10%
  );
  box-shadow:
    0 15px 35px rgba(0,0,0,.42),
    0 0 25px color-mix(
      in srgb,
      var(--interest) 14%,
      transparent
    );
}

.interest-area.selected{
  border-color:var(--interest);
  box-shadow:
    0 15px 35px rgba(0,0,0,.48),
    0 0 35px color-mix(
      in srgb,
      var(--interest) 20%,
      transparent
    ),
    inset 0 1px 0 rgba(255,255,255,.10);
}

.interest-orb{
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  float:left;
  margin-right:13px;
  border-radius:50%;
  background:
    radial-gradient(
      circle at 30% 20%,
      #fff,
      var(--interest) 42%,
      #100b1d 100%
    );
  border:1px solid rgba(255,255,255,.65);
  box-shadow:
    inset 0 2px 4px rgba(255,255,255,.65),
    0 0 20px color-mix(
      in srgb,
      var(--interest) 25%,
      transparent
    );
}

.interest-check{
  opacity:0;
  font-size:18px;
  font-weight:950;
}

.interest-area.selected .interest-check{
  opacity:1;
}

.interest-name{
  display:block;
  padding-top:2px;
  font-size:16px;
  line-height:1.2;
  font-weight:950;
}

.interest-description{
  display:block;
  margin-top:7px;
  color:#b9b5c0;
  font-size:12px;
  line-height:1.35;
  font-weight:600;
}

.board-dots{
  display:flex;
  justify-content:center;
  gap:7px;
  margin-top:23px;
}

.board-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:#3b3941;
  transition:.2s ease;
}

.board-dot.active{
  width:24px;
  border-radius:99px;
  background:#b895ff;
  box-shadow:0 0 14px rgba(184,149,255,.55);
}

.interest-actions{
  display:flex;
  justify-content:center;
  gap:12px;
  margin-top:24px;
}

.interest-actions .primary-black{
  min-width:220px;
}

.interest-skip{
  border:0;
  background:transparent;
  color:#898591;
  cursor:pointer;
  font-size:13px;
  font-weight:800;
}

.interest-skip:hover{
  color:#fff;
}


/* =========================================================
   RESULTS
========================================================= */

.results{
  display:none;
  width:100%;
  max-width:1060px;
  margin:auto;
}

.results.visible{
  display:block;
  animation:resultIn .65s var(--ease) both;
}

.result-hero{
  text-align:center;
}

.result-eyebrow{
  color:#c4a8ff;
  font-size:10px;
  font-weight:950;
  letter-spacing:.24em;
  text-transform:uppercase;
}

.result-title{
  margin:10px 0 0;
  font-size:clamp(38px,7vw,76px);
  line-height:.96;
  letter-spacing:-.055em;
  font-weight:950;
}

.result-subtitle{
  max-width:720px;
  margin:16px auto 0;
  color:#c7c3ce;
  font-size:17px;
  line-height:1.55;
}

.score-stage{
  position:relative;
  width:260px;
  height:260px;
  margin:34px auto 24px;
  display:grid;
  place-items:center;
}

.score-stage::before{
  content:"";
  position:absolute;
  inset:0;
  border-radius:50%;
  background:
    conic-gradient(
      from -90deg,
      var(--scoreColor) 0 var(--scoreDeg),
      rgba(255,255,255,.07) var(--scoreDeg) 100%
    );
  -webkit-mask:
    radial-gradient(
      farthest-side,
      transparent calc(100% - 12px),
      #000 calc(100% - 11px)
    );
  mask:
    radial-gradient(
      farthest-side,
      transparent calc(100% - 12px),
      #000 calc(100% - 11px)
    );
  filter:
    drop-shadow(
      0 0 18px
      color-mix(
        in srgb,
        var(--scoreColor) 38%,
        transparent
      )
    );
}

.score-stage::after{
  content:"";
  position:absolute;
  inset:26px;
  border-radius:50%;
  background:
    radial-gradient(
      circle at 35% 25%,
      rgba(255,255,255,.08),
      transparent 30%
    ),
    #09080d;
  border:1px solid rgba(255,255,255,.10);
  box-shadow:
    inset 0 0 40px rgba(138,92,255,.10),
    0 20px 50px rgba(0,0,0,.48);
}

.score-content{
  position:relative;
  z-index:2;
  text-align:center;
}

.score-number{
  display:block;
  font-size:72px;
  line-height:.9;
  font-weight:950;
  letter-spacing:-.06em;
}

.score-outof{
  display:block;
  margin-top:9px;
  color:#85818c;
  font-size:9px;
  letter-spacing:.18em;
  font-weight:950;
}

.result-level{
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:9px 17px;
  border:1px solid color-mix(
    in srgb,
    var(--scoreColor) 60%,
    white 8%
  );
  border-radius:999px;
  color:#fff;
  background:
    color-mix(
      in srgb,
      var(--scoreColor) 8%,
      #08080b
    );
  font-size:13px;
  font-weight:950;
  letter-spacing:.08em;
  text-transform:uppercase;
  box-shadow:
    0 0 25px color-mix(
      in srgb,
      var(--scoreColor) 13%,
      transparent
    );
}

.result-level-dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--scoreColor);
  box-shadow:
    0 0 12px var(--scoreColor);
}


/* =========================================================
   REPORT DIVIDERS
========================================================= */

.report-section{
  margin-top:58px;
}

.report-heading{
  text-align:center;
  margin-bottom:24px;
}

.report-kicker{
  color:#9f80e8;
  font-size:9px;
  font-weight:950;
  letter-spacing:.2em;
  text-transform:uppercase;
}

.report-heading h3{
  margin:7px 0 0;
  font-size:clamp(25px,4vw,38px);
  line-height:1.05;
  letter-spacing:-.035em;
  font-weight:950;
}

.report-heading p{
  max-width:680px;
  margin:11px auto 0;
  color:#aaa6b2;
  font-size:14px;
  line-height:1.5;
}


/* =========================================================
   DIMENSION CONSTELLATION
========================================================= */

.dimension-constellation{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:10px;
}

.dimension-orb{
  --dimensionColor:#8a5cff;
  position:relative;
  min-height:178px;
  padding:22px 14px 18px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  border:1px solid rgba(255,255,255,.10);
  border-radius:
    48% 52% 44% 56% /
    48% 44% 56% 52%;
  background:
    radial-gradient(
      circle at 50% 20%,
      color-mix(
        in srgb,
        var(--dimensionColor) 17%,
        transparent
      ),
      transparent 55%
    ),
    linear-gradient(
      145deg,
      #121117,
      #07070b
    );
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.07),
    0 14px 30px rgba(0,0,0,.32);
}

.dimension-ring{
  width:72px;
  height:72px;
  margin-bottom:12px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:
    conic-gradient(
      var(--dimensionColor) var(--dimDeg),
      rgba(255,255,255,.08) var(--dimDeg)
    );
  position:relative;
  box-shadow:
    0 0 25px color-mix(
      in srgb,
      var(--dimensionColor) 18%,
      transparent
    );
}

.dimension-ring::after{
  content:"";
  position:absolute;
  inset:7px;
  border-radius:50%;
  background:#0a090e;
  box-shadow:inset 0 0 12px rgba(0,0,0,.75);
}

.dimension-score{
  position:relative;
  z-index:1;
  font-size:18px;
  font-weight:950;
}

.dimension-name{
  font-size:13px;
  line-height:1.15;
  font-weight:950;
}

.dimension-status{
  margin-top:5px;
  color:#96919d;
  font-size:9px;
  font-weight:800;
  letter-spacing:.06em;
  text-transform:uppercase;
}


/* =========================================================
   INSIGHT FLOW
========================================================= */

.insight-flow{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:28px;
  align-items:stretch;
}

.insight{
  position:relative;
  min-height:220px;
  padding:34px 34px 30px;
  overflow:hidden;
  border-radius:
    55px 38px 50px 42px /
    42px 52px 40px 55px;
  background:
    radial-gradient(
      circle at 20% 0%,
      rgba(255,255,255,.08),
      transparent 35%
    ),
    linear-gradient(
      145deg,
      #141219,
      #08080c
    );
  border:1px solid rgba(255,255,255,.10);
  box-shadow:
    0 20px 45px rgba(0,0,0,.38),
    inset 0 1px 0 rgba(255,255,255,.07);
}

.insight::after{
  content:"";
  position:absolute;
  width:110px;
  height:110px;
  right:-35px;
  bottom:-45px;
  border-radius:50%;
  background:var(--insightColor);
  opacity:.10;
  filter:blur(20px);
}

.insight-cap{
  color:var(--insightColor);
  font-size:9px;
  font-weight:950;
  letter-spacing:.20em;
  text-transform:uppercase;
}

.insight h4{
  margin:10px 0 0;
  font-size:clamp(22px,3vw,31px);
  line-height:1.03;
  letter-spacing:-.035em;
  font-weight:950;
}

.insight p{
  margin:14px 0 0;
  color:#c3bfca;
  font-size:15px;
  line-height:1.55;
  font-weight:600;
}

.insight-score{
  position:absolute;
  top:25px;
  right:28px;
  font-size:34px;
  line-height:1;
  font-weight:950;
  color:var(--insightColor);
}


/* =========================================================
   INTELLIGENT ANALYSIS
========================================================= */

.analysis-cloud{
  position:relative;
  padding:35px 38px;
  border-radius:
    44px 58px 48px 54px /
    55px 45px 58px 46px;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(138,92,255,.11),
      transparent 45%
    ),
    linear-gradient(
      145deg,
      #121017,
      #07070b
    );
  border:1px solid rgba(181,140,255,.18);
  box-shadow:
    0 20px 45px rgba(0,0,0,.36),
    inset 0 1px 0 rgba(255,255,255,.07);
}

.analysis-cloud p{
  margin:0;
  color:#ded9e5;
  font-size:17px;
  line-height:1.7;
}

.analysis-cloud p + p{
  margin-top:16px;
}


/* =========================================================
   NEXT LEVEL PATH
========================================================= */

.path{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.path-step{
  position:relative;
  min-height:180px;
  padding:27px 24px;
  border-radius:
    40px 48px 38px 46px /
    46px 38px 48px 40px;
  background:
    linear-gradient(
      145deg,
      #131219,
      #08080c
    );
  border:1px solid rgba(255,255,255,.10);
  box-shadow:
    0 15px 35px rgba(0,0,0,.30),
    inset 0 1px 0 rgba(255,255,255,.06);
}

.path-number{
  width:36px;
  height:36px;
  display:grid;
  place-items:center;
  border-radius:50%;
  border:1px solid rgba(181,140,255,.48);
  color:#d0bcff;
  font-weight:950;
}

.path-step h4{
  margin:17px 0 0;
  font-size:18px;
  font-weight:950;
}

.path-step p{
  margin:9px 0 0;
  color:#aaa6b1;
  font-size:13px;
  line-height:1.5;
  font-weight:600;
}


/* =========================================================
   AI INTEREST SUMMARY
========================================================= */

.selected-interests{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:8px;
}

.interest-pill{
  padding:9px 14px;
  border-radius:999px;
  border:1px solid rgba(181,140,255,.24);
  background:rgba(138,92,255,.07);
  color:#ddd5ef;
  font-size:12px;
  font-weight:850;
}


/* =========================================================
   FINAL CTA
========================================================= */

.final-cta{
  position:relative;
  margin-top:58px;
  padding:48px 35px 42px;
  text-align:center;
  border-radius:
    60px 48px 58px 44px /
    46px 58px 44px 60px;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(138,92,255,.18),
      transparent 48%
    ),
    linear-gradient(
      145deg,
      #17121f,
      #08080c
    );
  border:1px solid rgba(181,140,255,.35);
  box-shadow:
    0 25px 70px rgba(0,0,0,.48),
    0 0 55px rgba(138,92,255,.12),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.final-cta::before{
  content:"";
  position:absolute;
  left:15%;
  right:15%;
  top:0;
  height:1px;
  background:
    linear-gradient(
      90deg,
      transparent,
      #c8a8ff,
      transparent
    );
}

.cta-eyebrow{
  color:#c9b0ff;
  font-size:9px;
  font-weight:950;
  letter-spacing:.22em;
  text-transform:uppercase;
}

.final-cta h3{
  max-width:760px;
  margin:12px auto 0;
  font-size:clamp(28px,4.8vw,48px);
  line-height:1.02;
  letter-spacing:-.045em;
  font-weight:950;
}

.final-cta p{
  max-width:670px;
  margin:16px auto 0;
  color:#c4bfca;
  font-size:16px;
  line-height:1.6;
}

.cta-actions{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
  margin-top:28px;
}

.cta-actions button{
  min-height:54px;
  padding:0 24px;
  border-radius:18px;
  border:1px solid rgba(181,140,255,.78);
  background:#07070a;
  color:#fff;
  font-weight:950;
  cursor:pointer;
}

.cta-actions button:hover{
  border-color:#d5c1ff;
  box-shadow:
    0 0 30px rgba(138,92,255,.22);
}

.cta-actions .secondary{
  border-color:rgba(255,255,255,.14);
  color:#aaa6b1;
}


/* =========================================================
   RESULT ACTIONS
========================================================= */

.result-actions{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
  margin-top:34px;
}

.result-actions button{
  min-height:51px;
  padding:0 21px;
  border-radius:17px;
  background:#08080b;
  color:#fff;
  border:1px solid rgba(181,140,255,.62);
  cursor:pointer;
  font-size:13px;
  font-weight:950;
}

.result-actions button:hover{
  border-color:#d0baff;
  box-shadow:0 0 25px rgba(138,92,255,.20);
}

.result-actions .quiet{
  border-color:rgba(255,255,255,.12);
  color:#aaa6b1;
}


/* =========================================================
   PRINT / PDF
========================================================= */

.print-only{
  display:none;
}

@media print{

  @page{
    size:Letter;
    margin:0.55in;
  }

  html,
  body{
    background:#fff!important;
    color:#111!important;
    font-family:Arial,sans-serif!important;
  }

  body{
    overflow:visible!important;
  }

  .maxess-app{
    background:#fff!important;
    min-height:auto!important;
  }

  .maxess-app::before,
  .maxess-app::after,
  .topbar,
  .footer,
  .command-row,
  .interstitial,
  .interest-actions,
  .result-actions,
  .final-cta .cta-actions{
    display:none!important;
  }

  .app-inner,
  .board-wrap,
  .board,
  .board-content{
    display:block!important;
    min-height:auto!important;
    padding:0!important;
    margin:0!important;
    border:0!important;
    box-shadow:none!important;
    background:#fff!important;
    overflow:visible!important;
  }

  .results{
    display:block!important;
    max-width:none!important;
    color:#111!important;
  }

  .result-title,
  .report-heading h3,
  .insight h4,
  .path-step h4,
  .final-cta h3{
    color:#111!important;
  }

  .result-subtitle,
  .report-heading p,
  .insight p,
  .analysis-cloud p,
  .path-step p,
  .final-cta p{
    color:#333!important;
  }

  .score-stage{
    break-inside:avoid;
  }

  .dimension-constellation{
    grid-template-columns:repeat(5,1fr)!important;
    break-inside:avoid;
  }

  .dimension-orb,
  .insight,
  .analysis-cloud,
  .path-step,
  .final-cta{
    background:#fafafa!important;
    color:#111!important;
    border:1px solid #ddd!important;
    box-shadow:none!important;
    break-inside:avoid;
  }

  .report-section{
    break-inside:avoid;
  }

  .final-cta{
    margin-top:35px!important;
  }

  .print-only{
    display:block!important;
    margin-bottom:25px;
    color:#111;
    font-size:11px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:760px){

  .aaa-status-rail{margin-bottom:10px;padding:7px 9px;font-size:8px;}


  .app-inner{
    padding:
      max(7px,env(safe-area-inset-top))
      max(5px,env(safe-area-inset-right))
      max(10px,env(safe-area-inset-bottom))
      max(5px,env(safe-area-inset-left));
  }

  .topbar{
    grid-template-columns:auto 1fr;
    gap:8px;
    padding-bottom:8px;
  }

  .brand{
    font-size:16px;
  }

  .question-count-chip{display:none;}

  .progress-hud{
    justify-self:end;
    width:auto;
    max-width:100%;
    padding:7px 9px;
    gap:7px;
  }

  .progress-label{
    font-size:8px;
    letter-spacing:.08em;
  }

  .progress-track{
    width:62px;
    min-width:62px;
    height:5px;
  }

  .progress-percent{
    min-width:29px;
    font-size:8px;
  }

  .board{
    border-radius:21px;
  }

  .board-content{
    padding:12px 8px 11px;
  }

