const $=id=>document.getElementById(id);const state={i:0,selected:null,responses:[],interests:new Set(),results:null,modal:false,naya:false};const qs=()=>ASSESSMENT.questions;const current=()=>qs()[state.i];const saveKey="maxess:aaa:v4";
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[m]))}
function updateProgress(){const n=qs().length,p=Math.round(((state.i+1)/n)*100);$("progressLabel").textContent=`QUESTION ${state.i+1} OF ${n}`;$("count").textContent=`QUESTION ${state.i+1} OF ${n}`;$("progressPercent").textContent=p+"%";$("progressFill").style.width=p+"%";$("step").textContent="STEP "+String(state.i+1).padStart(2,"0")}
function renderQuestion(){const q=current();state.selected=null;$("label").textContent=q.label;$("question").textContent=q.question;$("answers").innerHTML="";$("back").disabled=state.i===0;q.answers.forEach(a=>{const b=document.createElement("button");b.type="button";b.className="answer";b.dataset.id=a[0];b.style.setProperty("--accent",a[4]);b.setAttribute("aria-pressed","false");b.innerHTML=`<span class="jewel" aria-hidden="true">${esc(a[5])}</span><span class="answer-copy"><span class="answer-title">${esc(a[1])}</span><span class="answer-sub">${esc(a[2])}</span></span><span class="chev" aria-hidden="true">›</span>`;b.onclick=()=>select(b,a);$("answers").appendChild(b)});const saved=state.responses.find(r=>r.questionId===q.id);if(saved){const b=[...$("answers").querySelectorAll(".answer")].find(x=>x.dataset.id===saved.answerId);if(b){const a=q.answers.find(x=>x[0]===saved.answerId);select(b,a)}}updateProgress();$("continue").disabled=!state.selected}
function select(button,a){state.selected=a[0];document.querySelectorAll(".answer").forEach(b=>{const on=b===button;b.classList.toggle("selected",on);b.setAttribute("aria-pressed",String(on))});$("continue").disabled=false;button.focus()}
function persist(){try{localStorage.setItem(saveKey,JSON.stringify({i:state.i,responses:state.responses,interests:[...state.interests],savedAt:Date.now()}))}catch{}}
function saveResponse(){const q=current(),a=q.answers.find(x=>x[0]===state.selected);if(!a)return false;const r={questionId:q.id,dimensionId:q.dimensionId,answerId:a[0],score:a[3]};const ix=state.responses.findIndex(x=>x.questionId===q.id);ix>=0?state.responses[ix]=r:state.responses.push(r);persist();return true}
function openModal(){const q=current();$("cloudKicker").textContent=`${q.label} · QUESTION ${q.order}`;$("cloudBody").innerHTML=`<strong>${esc(q.teaching)}</strong>`;$("modal").classList.add("visible");state.modal=true;setTimeout(()=>$("cloudContinue").focus(),0)}function closeModal(){$("modal").classList.remove("visible");state.modal=false;setTimeout(()=>{const b=document.querySelector(".answer");b&&b.focus()},0)}
function back(){if(state.i<=0)return;stopNaya();state.i--;const saved=state.responses.find(r=>r.questionId===current().id);renderQuestion();if(saved){const b=[...$("answers").querySelectorAll(".answer")].find(x=>x.dataset.id===saved.answerId);if(b){const a=current().answers.find(x=>x[0]===saved.answerId);select(b,a)}}persist();setTimeout(openModal,120)}
