function showInterests(){$("assessment").hidden=true;$("interests").classList.add("visible");$("progressLabel").textContent="PERSONALIZE YOUR REPORT";$("count").textContent="FINAL STEP";$("progressFill").style.width="100%";$("progressPercent").textContent="100%";renderInterests()}
function renderInterests(){const grid=$("interestGrid");grid.innerHTML="";AI_AREAS.forEach(a=>{const b=document.createElement("button");b.type="button";b.className="interest"+(state.interests.has(a[0])?" selected":"");b.style.setProperty("--interest",a[3]);b.innerHTML=`<span class="interest-icon" aria-hidden="true">✦</span><span class="interest-name">${esc(a[1])}</span><span class="interest-desc">${esc(a[2])}</span>`;b.onclick=()=>{state.interests.has(a[0])?state.interests.delete(a[0]):state.interests.add(a[0]);renderInterests();persist()};grid.appendChild(b)})}
function calc(){const dims=ASSESSMENT.dimensions.map(d=>{const r=state.responses.filter(x=>x.dimensionId===d.id);const s=r.length?r.reduce((t,x)=>t+x.score,0)/r.length:0;return {...d,score:Math.round(s*10)/10}});const overall=Math.round((dims.reduce((t,d)=>t+d.score*d.weight,0)/dims.reduce((t,d)=>t+d.weight,0))*10)/10;const band=ASSESSMENT.bands.find(b=>overall>=b.min&&overall<=b.max)||ASSESSMENT.bands[3];return{overall,dims,band}}
function msgStrong(d){return({direction:"You already think in terms of destinations, which helps AI work toward outcomes instead of merely generating text.",communication:"You have a strong ability to translate human intent into instructions AI can actually use.",evaluation:"You have a strong quality-control instinct. You are more likely to question an impressive-looking answer instead of simply accepting it.",iteration:"You understand that good work is built through refinement. That gives you a major advantage because AI becomes more useful when you direct the next version intelligently.",systems:"You are thinking beyond individual outputs toward reusable capability. That is the bridge from using AI to building with AI."})[d.id]}
function msgOpp(d){return({direction:"Make the destination even clearer before you begin. A sharper target can reduce wasted iterations.",communication:"Give AI richer context, audience and constraints. Better communication usually means less correction later.",evaluation:"Strengthen your quality filter. Make “Why is this not a 10?” a normal part of important AI work.",iteration:"Diagnose the weakness, preserve what works, improve what does not, and repeat.",systems:"Capture what works. A successful workflow should become an asset you can reuse rather than a trick you have to rediscover."})[d.id]}
function level(s){return s>=90?"Master":s>=75?"Advancing":s>=60?"Developing":"Foundation"}
function renderResults(){const r=calc();state.results=r;$("interests").classList.remove("visible");$("results").classList.add("visible");$("score").textContent=Math.round(r.overall);$("scoreRing").style.setProperty("--scoreColor",r.band.color);$("scoreRing").style.setProperty("--scoreDeg",r.overall*3.6+"deg");$("level").textContent=`${r.band.label} · ${Math.round(r.overall)}/100`;$("subtitle").textContent=r.band.desc;$("dimensions").innerHTML=r.dims.map(d=>`<div class="dimension"><div class="ring" style="--c:${d.color};--deg:${d.score*3.6}deg"><b>${Math.round(d.score)}</b></div><div class="dim-name">${esc(d.name)}</div><div class="dim-level">${level(d.score)}</div></div>`).join("");const strongest=[...r.dims].sort((a,b)=>b.score-a.score)[0],opp=[...r.dims].sort((a,b)=>a.score-b.score)[0];$("strongScore").textContent=Math.round(strongest.score);$("strongName").textContent=strongest.name;$("strongText").textContent=msgStrong(strongest);$("oppScore").textContent=Math.round(opp.score);$("oppName").textContent=opp.name;$("oppText").textContent=msgOpp(opp);const opening=r.overall>=90?"Your score shows highly developed AI craftsmanship. Your next gains are about leverage, refinement and system-building.":r.overall>=75?"Your score shows meaningful AI capability. Your next gains are likely to come from becoming more deliberate and repeatable.":r.overall>=60?"Your score shows a useful foundation with significant room to grow. The biggest gains usually come from changing how you work with AI, not collecting hundreds of tools.":"Your score shows a large opportunity ahead. That is not a judgment of your potential — it is a map of where a few foundational habits can create major gains.";$("cherry").innerHTML=`<p><strong>Here's the part I would remember:</strong> your profile suggests that ${esc(strongest.name.toLowerCase())} is currently one of your strongest AI habits, while ${esc(opp.name.toLowerCase())} is where a focused improvement could create the most leverage.</p><p>${esc(msgOpp(opp))}</p><p>That combination is not a label. It is a useful starting point for what you do next.</p>`;$("analysis").innerHTML=`<p>${esc(opening)}</p><p><strong>Your strongest dimension is ${esc(strongest.name)} at ${Math.round(strongest.score)}/100.</strong> ${esc(msgStrong(strongest))}</p><p><strong>Your biggest leverage opportunity is ${esc(opp.name)} at ${Math.round(opp.score)}/100.</strong> ${esc(msgOpp(opp))}</p><p>AI is the engine. You are the director. Your advantage grows when you know what you want, communicate it clearly, judge the result honestly, improve it deliberately, and turn successful work into something reusable.</p>`;$("star").innerHTML=`<p><strong>For your next important AI task:</strong> before you start, define what a 10/10 result would look like. Then ask AI to create it, inspect it, score it, improve it, and preserve what already works.</p><p>One better workflow is worth more than a hundred unused tips.</p>`;const path=[{t:`Strengthen ${opp.name}`,b:msgOpp(opp)},{t:"Use the 10-point test",b:"Before accepting an important AI result, ask what is working, what is missing, what is unclear, and what could be better — then direct the next version."},{t:"Turn wins into systems",b:"When you discover a workflow that works, save the method. Your future self should start from the successful version, not a blank page."}];$("path").innerHTML=path.map((x,i)=>`<article class="step"><div class="step-no">${i+1}</div><h4>${esc(x.t)}</h4><p>${esc(x.b)}</p></article>`).join("");const selected=AI_AREAS.filter(a=>state.interests.has(a[0]));$("interestIntro").textContent=selected.length?"These are the areas you told us you want AI to become more useful in.":"You kept this open. Your report is based entirely on your assessment profile.";$("pills").innerHTML=selected.length?selected.map(a=>`<span class="pill">${esc(a[1])}</span>`).join(""):`<span class="pill">No specific areas selected</span>`;$("ctaTitle").textContent=r.overall>=90?"You are ready to turn AI capability into leverage.":r.overall>=75?"You are closer to the next level than you may think.":"You now know exactly where to begin.";$("ctaBody").textContent="Your score is not a judgment of your worth. It is a current capability map. The next step is to strengthen the few habits that will multiply what you can already do.";window.scrollTo({top:0,behavior:"smooth"});persist()}
let utterance=null;function stopNaya(){try{speechSynthesis.cancel()}catch{}state.naya=false;$("naya").classList.remove("playing");$("naya").setAttribute("aria-pressed","false");$("nayaMain").textContent="Press Play";$("nayaSub").textContent="Listen to Naya"}function playNaya(){if(!( "speechSynthesis" in window)){ $("nayaMain").textContent="Audio unavailable";$("nayaSub").textContent="Speech is not supported here";setTimeout(stopNaya,2200);return}stopNaya();const q=current();utterance=new SpeechSynthesisUtterance(`Question ${q.order}. ${q.question}`);utterance.rate=.92;utterance.pitch=1.02;utterance.onstart=()=>{state.naya=true;$("naya").classList.add("playing");$("naya").setAttribute("aria-pressed","true");$("nayaMain").textContent="Pause Naya";$("nayaSub").textContent="Naya is speaking"};utterance.onend=stopNaya;utterance.onerror=stopNaya;speechSynthesis.speak(utterance)}
function reset(){stopNaya();Object.assign(state,{i:0,selected:null,responses:[],interests:new Set(),results:null});try{localStorage.removeItem(saveKey)}catch{}$("results").classList.remove("visible");$("interests").classList.remove("visible");$("assessment").hidden=false;renderQuestion();setTimeout(openModal,140)}function load(){try{const x=JSON.parse(localStorage.getItem(saveKey)||"null");if(!x)return;if(Array.isArray(x.responses)&&x.responses.length&&x.responses.length<15){state.responses=x.responses;state.i=Math.min(x.i||0,14);state.interests=new Set(x.interests||[])}}catch{}}function validate(){if(qs().length!==15)throw Error("MAXESS requires 15 questions");if(ASSESSMENT.dimensions.length!==5)throw Error("MAXESS requires five dimensions");if(AI_AREAS.length!==18)throw Error("MAXESS requires 18 AI pathways");qs().forEach(q=>{if(q.answers.length!==5)throw Error("Every question requires five answers")})}
$("continue").onclick=next;$("back").onclick=back;$("cloudContinue").onclick=closeModal;$("naya").onclick=()=>state.naya?stopNaya():playNaya();$("interestContinue").onclick=renderResults;$("interestSkip").onclick=renderResults;$("print").onclick=()=>window.print();$("restart").onclick=reset;$("nayaNet").onclick=()=>window.open("https://nayanet.xyz/","_blank","noopener,noreferrer");$("trial").onclick=()=>window.open("https://nayanet.xyz/","_blank","noopener,noreferrer");$("modal").addEventListener("click",e=>{if(e.target===$("modal"))closeModal()});document.addEventListener("keydown",e=>{if(e.key==="Escape"){if(state.modal)closeModal();else if(state.naya)stopNaya()}if(state.modal)return;const a=[...document.querySelectorAll(".answer")],idx=a.indexOf(document.activeElement);if(!a.length)return;if(e.key==="ArrowDown"||e.key==="ArrowRight"){e.preventDefault();a[Math.min(idx<0?0:idx+1,a.length-1)].focus()}if(e.key==="ArrowUp"||e.key==="ArrowLeft"){e.preventDefault();a[Math.max(idx<0?0:idx-1,0)].focus()}if(e.key==="Enter"&&idx>=0){e.preventDefault();a[idx].click()}});try{validate();load();renderInterests();renderQuestion();setTimeout(openModal,160)}catch(e){console.error(e);$("question").textContent="MAXESS is temporarily unavailable.";$("answers").innerHTML=""}
