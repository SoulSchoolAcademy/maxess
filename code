/* =========================================================
   NAYA
========================================================= */

let nayaSpeechUtterance=null;


function playNaya(){

  if(!("speechSynthesis" in window)){
    DOM.nayaPrimary.textContent="Audio unavailable";
    DOM.nayaSecondary.textContent="Speech is not supported here";
    setTimeout(stopNaya,2200);
    return;
  }

  stopNaya();

  const question=
    currentQuestion();

  if(!question){
    return;
  }

  nayaSpeechUtterance=
    new SpeechSynthesisUtterance(
      question.question
    );

  nayaSpeechUtterance.rate=.92;
  nayaSpeechUtterance.pitch=1.02;
  nayaSpeechUtterance.volume=1;

  nayaSpeechUtterance.onstart=()=>{

    state.nayaPlaying=true;

    DOM.nayaButton.classList.add(
      "playing"
    );

    DOM.nayaButton.setAttribute(
      "aria-pressed",
      "true"
    );

    DOM.nayaPrimary.textContent=
      "Pause Naya";

    DOM.nayaSecondary.textContent=
      "Naya is speaking";

  };

  nayaSpeechUtterance.onend=
    stopNaya;

  nayaSpeechUtterance.onerror=
    stopNaya;

  window.speechSynthesis.speak(
    nayaSpeechUtterance
  );

}


function stopNaya(){

  if("speechSynthesis" in window){

    window.speechSynthesis.cancel();

  }

  state.nayaPlaying=false;

  DOM.nayaButton.classList.remove(
    "playing"
  );

  DOM.nayaButton.setAttribute(
    "aria-pressed",
    "false"
  );

  DOM.nayaPrimary.textContent=
    "Press Play";

  DOM.nayaSecondary.textContent=
    "Listen to Naya";

}


