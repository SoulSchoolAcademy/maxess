   CONTINUE BUTTON
========================================================= */

function updateContinue(){

  const enabled=
    !!state.selectedAnswerId &&
    !state.transitioning;

  DOM.continueButton.disabled=
    !enabled;

  DOM.continueButton.setAttribute(
    "aria-disabled",
    String(!enabled)
  );

  const final=
