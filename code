}


function answerObjects(question){

  return question.answers.map(item=>({

    id:item[0],
    title:item[1],
    description:item[2],
    score:item[3],
    accent:item[4],
    glyph:item[5]

  }));

}


function escapeHtml(value){

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


