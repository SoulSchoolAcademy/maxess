/* =========================================================
   AAA V3 KEYBOARD ANSWER NAVIGATION
========================================================= */

document.addEventListener(
  "keydown",
  event => {

    if(
      state.teachingOpen ||
      state.transitioning
    ){
      return;
    }


    const answers =
      [
        ...DOM.answers.querySelectorAll(
          ".answer"
        )
      ];


    if(!answers.length){
      return;
    }


    const active =
      document.activeElement;


    const index =
      answers.indexOf(
        active
      );


    if(
      event.key === "ArrowDown" ||
      event.key === "ArrowRight"
    ){

      event.preventDefault();

      answers[
        Math.min(
          index < 0 ? 0 : index + 1,
          answers.length - 1
        )
      ].focus();

    }else if(
      event.key === "ArrowUp" ||
      event.key === "ArrowLeft"
    ){

      event.preventDefault();

      answers[
        Math.max(
          index < 0 ? 0 : index - 1,
          0
        )
      ].focus();

    }else if(
      event.key === "Enter" &&
      index >= 0
    ){

      event.preventDefault();

      active.click();

    }

  }
);
